{
    "name": "baboons-qr-code-frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "cross-env NODE_ENV=production nuxt build",
        "dev": "nuxt dev --host 0.0.0.0",
        "preview": "nuxt preview --host 0.0.0.0",
        "postinstall": "nuxt prepare",
        "test:helpers": "tsc --ignoreConfig --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --skipLibCheck --types node tests/helpers.test.ts && node --experimental-strip-types tests/helpers.test.ts",
        "test:e2e": "playwright test",
        "ts:check": "biome check . && tsc --noEmit -p tsconfig.json",
        "ts:fix": "biome check --write .",
        "ts:format": "biome format --write .",
        "ts:lint": "biome lint .",
        "ts:typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "flyonui": "^2.4.1",
        "nuxt": "^4.5.2",
        "qr-code-styling": "^1.9.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@iconify-json/tabler": "^1.2.22",
        "@iconify/tailwind4": "^1.2.3",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.0",
        "cross-env": "^10.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.0"
    }
}
