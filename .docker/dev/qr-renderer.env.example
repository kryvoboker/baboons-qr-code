# Copy to .docker/dev/env/.env.qr-renderer and generate a secret with openssl rand -hex 32.
QR_RENDERER_SHARED_SECRET=
NUXT_QR_RENDERER_SHARED_SECRET=${QR_RENDERER_SHARED_SECRET}
QR_RENDERER_URL=http://qr-renderer:3100
NUXT_QR_RENDERER_INTERNAL_BASE=http://qr-renderer:3100
SHARED_STORAGE_PATH=/shared/storage
STORAGE_PUBLIC_URL=http://dev.api.dev-nuxt.com.ua/storage
NUXT_PUBLIC_STORAGE_BASE=${STORAGE_PUBLIC_URL}
STORAGE_INTERNAL_URL=http://dev-nuxt-nginx/storage
